"	--	netrw settings	--
set nocompatible
let g:netrw_banner=0
let g:netrw_liststyle=3
" let g:netrw_browse_split=4
" let g:netrw_altv=1

"	--	vim settings	--
set number
set relativenumber
set path+=**
" set wildmenu

syntax on
filetype plugin indent on
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4
set smartindent
